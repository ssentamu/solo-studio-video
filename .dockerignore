# Never send repository metadata, credentials, or runtime state to the Docker daemon.
.git/
.gitignore
.dockerignore
.github/
.env
.env.*
.solo_studio_api_token
**/credentials.json
jobs.json
jobs.json.lock
state/
output/
briefs/
*.env
*.pem
*.key
*.p12
credentials.*
**/credentials.*

# Runtime databases and SQLite sidecars/journals.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*-journal
*.wal
*.shm

# Logs and generated runtime/cache data.
*.log
*.log.*
logs/
**/logs/
.cache/
**/.cache/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage/

# Local environments, package-manager credentials, and development metadata.
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
node_modules/
**/node_modules/
.npmrc
**/.npmrc
.pypirc
**/.pypirc
.netrc
**/.netrc
.aws/
**/.aws/
.gcloud/
**/.config/gcloud/
.vscode/
**/.vscode/
.idea/
**/.idea/
.circleci/
**/.circleci/
.gitlab-ci.yml
.pre-commit-config.yaml
pytest.ini
tox.ini
noxfile.py
*.code-workspace

# Project content not needed by the Dockerfile.
tests/
__pycache__/
*.pyc
*.pyo
*.swp
*.swo
*.tar
README.md
PRD.md
deploy-traefik.sh
